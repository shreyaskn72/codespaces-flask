{
  "name": "Python Dev",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },

  "hostRequirements": {
    "cpus": 4
  },

  "postCreateCommand": "bash .devcontainer/postcreate.sh",

  "postAttachCommand": {
    "server": "flask --debug run --host=0.0.0.0"
  },

  "forwardPorts": [5000],

  "portsAttributes": {
    "5000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },

  "remoteUser": "vscode"
}

